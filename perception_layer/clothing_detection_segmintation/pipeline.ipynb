    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import torch\\n\",\n",
    "    \"from rfdetr import RFDETRNano\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Initialize model\\n\",\n",
    "    \"model = RFDETRNano()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Device\\n\",\n",
    "    \"device = \\\"cuda\\\" if torch.cuda.is_available() else \\\"cpu\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Train\\n\",\n",
    "    \"model.train(\\n\",\n",
    "    \"    # --- Data ---\\n\",\n",
    "    \"    dataset_dir=\\\"../../data/fashionpedia_coco\\\",\\n\",\n",
    "    \"    output_dir=\\\"output\\\",\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # --- Hardware ---\\n\",\n",
    "    \"    device=device,\\n\",\n",
    "    \"    batch_size=4,\\n\",\n",
    "    \"    grad_accum_steps=4,   # effective batch = 16\\n\",\n",
    "    \"    num_workers=2,\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # --- Training ---\\n\",\n",
    "    \"    epochs=100,\\n\",\n",
    "    \"    lr=5e-5,              # better for smaller datasets\\n\",\n",
    "    \"    weight_decay=1e-4,\\n\",\n",
    "    \"    use_ema=True,\\n\",\n",
    "    \"    early_stopping=True,\\n\",\n",
    "    \"    early_stopping_patience=10,\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # --- Accuracy ---\\n\",\n",
    "    \"    resolution=512,       # safer; use 640 if VRAM allows\\n\",\n",
    "    \"    multi_scale=True,\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # --- Logging ---\\n\",\n",
    "    \"    checkpoint_interval=5,\\n\",\n",
    "    \"    tensorboard=True\\n\",\n",
    "    \")\"\n",
    "   ],\n",
