    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# 2. Create 70/20/10 Splits\\n\",\n",
    "    \"# First split off the test set (10%)\\n\",\n",
    "    \"ds_30p = full_ds.train_test_split(test_size=0.7, seed=42)\\n\",\n",
    "    \"ds_30p\\n\",\n",
    "    \"test_ds = train_valid_test[\\\"test\\\"]\"\n",
    "   ],\n",
    "   \"id\": \"518b79e544d9c803\",\n",
