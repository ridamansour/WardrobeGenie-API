    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# Then split the remaining 90% into train (70% total) and valid (20% total)\\n\",\n",
    "    \"    # 0.222 roughly equals 20% of the original 100%\\n\",\n",
    "    \"    train_valid = train_valid_test[\\\"train\\\"].train_test_split(test_size=0.222, seed=42)\"\n",
    "   ],\n",
    "   \"id\": \"4141dcaf5b6e450b\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import os\\n\",\n",
    "    \"import json\\n\",\n",
    "    \"import torch\\n\",\n",
    "    \"from tqdm import tqdm\\n\",\n",
    "    \"from datasets import load_dataset\\n\",\n",
    "    \"\\n\",\n",
    "    \"def prepare_fashionpedia_complete(output_dir=\\\"./fashionpedia_coco\\\"):\\n\",\n",
    "    \"    # 1. Load Dataset\\n\",\n",
    "    \"    print(\\\"Loading Fashionpedia...\\\")\\n\",\n",
    "    \"    full_ds = load_dataset(\\\"detection-datasets/fashionpedia\\\", split=\\\"train\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 2. Create 70/20/10 Splits\\n\",\n",
    "    \"    # First split off the test set (10%)\\n\",\n",
    "    \"    train_valid_test = full_ds.train_test_split(test_size=0.1, seed=42)\\n\",\n",
    "    \"    test_ds = train_valid_test[\\\"test\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Then split the remaining 90% into train (70% total) and valid (20% total)\\n\",\n",
    "    \"    # 0.222 roughly equals 20% of the original 100%\\n\",\n",
    "    \"    train_valid = train_valid_test[\\\"train\\\"].train_test_split(test_size=0.222, seed=42)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    dataset_splits = {\\n\",\n",
    "    \"        \\\"train\\\": train_valid[\\\"train\\\"],\\n\",\n",
    "    \"        \\\"valid\\\": train_valid[\\\"test\\\"],\\n\",\n",
    "    \"        \\\"test\\\": test_ds\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for split, ds in dataset_splits.items():\\n\",\n",
    "    \"        split_path = os.path.join(output_dir, split)\\n\",\n",
    "    \"        os.makedirs(split_path, exist_ok=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        coco_data = {\\\"images\\\": [], \\\"annotations\\\": [], \\\"categories\\\": []}\\n\",\n",
    "    \"        unique_cats = set()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        print(f\\\"Processing {split} split ({len(ds)} images)...\\\")\\n\",\n",
    "    \"        for idx, sample in enumerate(tqdm(ds)):\\n\",\n",
    "    \"            file_name = f\\\"{idx}.jpg\\\"\\n\",\n",
    "    \"            img_path = os.path.join(split_path, file_name)\\n\",\n",
    "    \"            sample['image'].save(img_path)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            coco_data[\\\"images\\\"].append({\\n\",\n",
    "    \"                \\\"id\\\": idx, \\\"file_name\\\": file_name,\\n\",\n",
    "    \"                \\\"width\\\": sample['image'].size[0], \\\"height\\\": sample['image'].size[1]\\n\",\n",
    "    \"            })\\n\",\n",
    "    \"\\n\",\n",
    "    \"            obj_data = sample['objects']\\n\",\n",
    "    \"            segs = obj_data.get('segmentation')\\n\",\n",
    "    \"            for i in range(len(obj_data['category'])):\\n\",\n",
    "    \"                bbox = obj_data['bbox'][i]\\n\",\n",
    "    \"                coco_bbox = [float(bbox[1]), float(bbox[0]), float(bbox[3]-bbox[1]), float(bbox[2]-bbox[0])]\\n\",\n",
    "    \"                seg = segs[i] if segs and i < len(segs) else []\\n\",\n",
    "    \"\\n\",\n",
    "    \"                coco_data[\\\"annotations\\\"].append({\\n\",\n",
    "    \"                    \\\"id\\\": len(coco_data[\\\"annotations\\\"]),\\n\",\n",
    "    \"                    \\\"image_id\\\": idx,\\n\",\n",
    "    \"                    \\\"category_id\\\": int(obj_data['category'][i]),\\n\",\n",
    "    \"                    \\\"bbox\\\": coco_bbox,\\n\",\n",
    "    \"                    \\\"area\\\": float(coco_bbox[2] * coco_bbox[3]),\\n\",\n",
    "    \"                    \\\"segmentation\\\": seg,\\n\",\n",
    "    \"                    \\\"iscrowd\\\": 0\\n\",\n",
    "    \"                })\\n\",\n",
    "    \"                unique_cats.add(obj_data['category'][i])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for cat_id in sorted(list(unique_cats)):\\n\",\n",
    "    \"            coco_data[\\\"categories\\\"].append({\\n\",\n",
    "    \"                \\\"id\\\": int(cat_id), \\\"name\\\": f\\\"class_{cat_id}\\\", \\\"supercategory\\\": \\\"fashion\\\"\\n\",\n",
    "    \"            })\\n\",\n",
    "    \"\\n\",\n",
    "    \"        with open(os.path.join(split_path, \\\"_annotations.coco.json\\\"), \\\"w\\\") as f:\\n\",\n",
    "    \"            json.dump(coco_data, f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Execute\\n\",\n",
    "    \"prepare_fashionpedia_complete()\"\n",
    "   ],\n",
    "   \"id\": \"1a23d0187c46a695\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import os\\n\",\n",
    "    \"import json\\n\",\n",
    "    \"from tqdm import tqdm\\n\",\n",
    "    \"from datasets import load_dataset\\n\",\n",
    "    \"\\n\",\n",
    "    \"def prepare_fashionpedia_subset(\\n\",\n",
    "    \"    output_dir=\\\"./fashionpedia_coco\\\",\\n\",\n",
    "    \"    subset_ratio=0.2,\\n\",\n",
    "    \"    seed=42\\n\",\n",
    "    \"):\\n\",\n",
    "    \"    print(\\\"Loading Fashionpedia...\\\")\\n\",\n",
    "    \"    full_ds = load_dataset(\\\"detection-datasets/fashionpedia\\\", split=\\\"train\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # -------- STEP 1: sample 20% of dataset --------\\n\",\n",
    "    \"    print(f\\\"Sampling {int(subset_ratio*100)}% of dataset...\\\")\\n\",\n",
    "    \"    subset = full_ds.train_test_split(\\n\",\n",
    "    \"        test_size=1 - subset_ratio,\\n\",\n",
    "    \"        seed=seed\\n\",\n",
    "    \"    )[\\\"train\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"Subset size: {len(subset)} images\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # -------- STEP 2: create 70/20/10 splits --------\\n\",\n",
    "    \"    split_90_10 = subset.train_test_split(test_size=0.1, seed=seed)\\n\",\n",
    "    \"    test_ds = split_90_10[\\\"test\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    split_70_20 = split_90_10[\\\"train\\\"].train_test_split(\\n\",\n",
    "    \"        test_size=0.222,  # 20% of original\\n\",\n",
    "    \"        seed=seed\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    dataset_splits = {\\n\",\n",
    "    \"        \\\"train\\\": split_70_20[\\\"train\\\"],\\n\",\n",
    "    \"        \\\"valid\\\": split_70_20[\\\"test\\\"],\\n\",\n",
    "    \"        \\\"test\\\": test_ds\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # -------- STEP 3: export to COCO --------\\n\",\n",
    "    \"    for split, ds in dataset_splits.items():\\n\",\n",
    "    \"        split_path = os.path.join(output_dir, split)\\n\",\n",
    "    \"        os.makedirs(split_path, exist_ok=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        coco_data = {\\\"images\\\": [], \\\"annotations\\\": [], \\\"categories\\\": []}\\n\",\n",
    "    \"        unique_cats = set()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        print(f\\\"Processing {split} split ({len(ds)} images)...\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for idx, sample in enumerate(tqdm(ds)):\\n\",\n",
    "    \"            file_name = f\\\"{idx}.jpg\\\"\\n\",\n",
    "    \"            img_path = os.path.join(split_path, file_name)\\n\",\n",
    "    \"            sample[\\\"image\\\"].save(img_path)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            coco_data[\\\"images\\\"].append({\\n\",\n",
    "    \"                \\\"id\\\": idx,\\n\",\n",
    "    \"                \\\"file_name\\\": file_name,\\n\",\n",
    "    \"                \\\"width\\\": sample[\\\"image\\\"].size[0],\\n\",\n",
    "    \"                \\\"height\\\": sample[\\\"image\\\"].size[1],\\n\",\n",
    "    \"            })\\n\",\n",
    "    \"\\n\",\n",
    "    \"            obj_data = sample[\\\"objects\\\"]\\n\",\n",
    "    \"            segs = obj_data.get(\\\"segmentation\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"            for i in range(len(obj_data[\\\"category\\\"])):\\n\",\n",
    "    \"                bbox = obj_data[\\\"bbox\\\"][i]\\n\",\n",
    "    \"\\n\",\n",
    "    \"                coco_bbox = [\\n\",\n",
    "    \"                    float(bbox[1]),\\n\",\n",
    "    \"                    float(bbox[0]),\\n\",\n",
    "    \"                    float(bbox[3] - bbox[1]),\\n\",\n",
    "    \"                    float(bbox[2] - bbox[0]),\\n\",\n",
    "    \"                ]\\n\",\n",
    "    \"\\n\",\n",
    "    \"                seg = segs[i] if segs and i < len(segs) else []\\n\",\n",
    "    \"\\n\",\n",
    "    \"                coco_data[\\\"annotations\\\"].append({\\n\",\n",
    "    \"                    \\\"id\\\": len(coco_data[\\\"annotations\\\"]),\\n\",\n",
    "    \"                    \\\"image_id\\\": idx,\\n\",\n",
    "    \"                    \\\"category_id\\\": int(obj_data[\\\"category\\\"][i]),\\n\",\n",
    "    \"                    \\\"bbox\\\": coco_bbox,\\n\",\n",
    "    \"                    \\\"area\\\": float(coco_bbox[2] * coco_bbox[3]),\\n\",\n",
    "    \"                    \\\"segmentation\\\": seg,\\n\",\n",
    "    \"                    \\\"iscrowd\\\": 0,\\n\",\n",
    "    \"                })\\n\",\n",
    "    \"\\n\",\n",
    "    \"                unique_cats.add(obj_data[\\\"category\\\"][i])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for cat_id in sorted(unique_cats):\\n\",\n",
    "    \"            coco_data[\\\"categories\\\"].append({\\n\",\n",
    "    \"                \\\"id\\\": int(cat_id),\\n\",\n",
    "    \"                \\\"name\\\": f\\\"class_{cat_id}\\\",\\n\",\n",
    "    \"                \\\"supercategory\\\": \\\"fashion\\\",\\n\",\n",
    "    \"            })\\n\",\n",
    "    \"\\n\",\n",
    "    \"        with open(os.path.join(split_path, \\\"_annotations.coco.json\\\"), \\\"w\\\") as f:\\n\",\n",
    "    \"            json.dump(coco_data, f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(\\\"\\\\nDone!\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Execute\\n\",\n",
    "    \"prepare_fashionpedia_subset()\"\n",
    "   ],\n",
